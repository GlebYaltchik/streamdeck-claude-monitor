{
  "_comment": "Sends Claude Code hook events to the local ClaudeDeck agent. Every event but one is answered 204 with no body, so nothing here influences a session. PermissionRequest is held open by the agent while its question is on screen: the client closes the connection when the question is answered, which is the only signal that says so. Notification is deliberately absent: it was measured never to fire, see docs/findings/hooks.md.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --connect-timeout 0.1 --max-time 2 -X POST --data-binary \"@-\" http://127.0.0.1:17800/hook/SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --connect-timeout 0.1 --max-time 2 -X POST --data-binary \"@-\" http://127.0.0.1:17800/hook/UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --connect-timeout 0.1 --max-time 2 -X POST --data-binary \"@-\" http://127.0.0.1:17800/hook/PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:17800/hook/PermissionRequest",
            "timeout": 3600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --connect-timeout 0.1 --max-time 2 -X POST --data-binary \"@-\" http://127.0.0.1:17800/hook/PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --connect-timeout 0.1 --max-time 2 -X POST --data-binary \"@-\" http://127.0.0.1:17800/hook/Stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --connect-timeout 0.1 --max-time 2 -X POST --data-binary \"@-\" http://127.0.0.1:17800/hook/SubagentStop",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --connect-timeout 0.1 --max-time 2 -X POST --data-binary \"@-\" http://127.0.0.1:17800/hook/PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --connect-timeout 0.1 --max-time 2 -X POST --data-binary \"@-\" http://127.0.0.1:17800/hook/SessionEnd",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
