<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A library, not a service: for v1 the hub runs inside the plugin process. Keeping it
         separate is what lets it move out later without a rewrite. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClaudeDeck.Hub</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeDeck.Protocol\ClaudeDeck.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeDeck.Hub.Tests" />
  </ItemGroup>

</Project>
