{
  "Name": "ClaudeDeck Probe",
  "Version": "0.0.1.0",
  "Author": "Gleb Yaltchik",
  "Description": "Phase 0 probe: reports what the device is and validates SVG keys and encoder feedback.",
  "Category": "ClaudeDeck",
  "CategoryIcon": "imgs/plugin",
  "Icon": "imgs/plugin",
  "URL": "https://github.com/GlebYaltchik/streamdeck-claude-monitor",
  "CodePath": "bin/ClaudeDeck.Plugin.exe",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Probe Key",
      "UUID": "com.gyaltchik.claudedeck.probe-key",
      "Icon": "imgs/key",
      "Tooltip": "Draws an SVG image to prove keys need no imaging library.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Probe Dial",
      "UUID": "com.gyaltchik.claudedeck.probe-dial",
      "Icon": "imgs/key",
      "Tooltip": "Counts rotation ticks to prove encoders and the touch strip work.",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Count ticks",
          "Push": "Nothing yet"
        }
      },
      "States": [
        {
          "Image": "imgs/key"
        }
      ]
    }
  ],
  "UUID": "com.gyaltchik.claudedeck"
}
