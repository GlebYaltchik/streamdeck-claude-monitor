{
  "Name": "ClaudeDeck",
  "Version": "0.1.0.0",
  "Author": "Gleb Yaltchik",
  "Description": "Claude Code usage limits and live session state on your Stream Deck.",
  "Category": "ClaudeDeck",
  "CategoryIcon": "imgs/plugin",
  "Icon": "imgs/plugin",
  "URL": "https://github.com/GlebYaltchik/streamdeck-claude-monitor",
  "CodePath": "bin/ClaudeDeck.Plugin.exe",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Usage",
      "UUID": "com.gyaltchik.claudedeck.usage",
      "Icon": "imgs/key",
      "Tooltip": "Claude Code usage: the five-hour or weekly window, with the time it resets.",
      "PropertyInspectorPath": "ui/usage.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/usage.json",
        "TriggerDescription": {
          "Rotate": "Switch window",
          "Push": "Switch window",
          "Touch": "Switch window"
        }
      },
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Session",
      "UUID": "com.gyaltchik.claudedeck.session",
      "Icon": "imgs/key",
      "Tooltip": "One Claude Code session: what it is called, what it is doing, and how full its context is. It flashes when its turn ends; tap to acknowledge, hold to clear a session that is gone.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "middle"
        }
      ],
      "PropertyInspectorPath": "ui/approvals.html"
    },
    {
      "Name": "Alerts",
      "UUID": "com.gyaltchik.claudedeck.alerts",
      "Icon": "imgs/key",
      "Tooltip": "Silences flashing session keys. Changes no session, and unmuting shows everything still waiting.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Summary",
      "UUID": "com.gyaltchik.claudedeck.summary",
      "Icon": "imgs/key",
      "Tooltip": "How many Claude Code sessions are live, and how many agents report them.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Approvals",
      "UUID": "com.gyaltchik.claudedeck.mode",
      "Icon": "imgs/key",
      "Tooltip": "How far the deck is allowed into permission decisions: off, observe or active.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Pending approval",
      "UUID": "com.gyaltchik.claudedeck.approval",
      "Icon": "imgs/key",
      "Tooltip": "What a session is waiting to be allowed to do.",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/approval.json",
        "TriggerDescription": {
          "Rotate": "",
          "Push": "",
          "Touch": ""
        }
      },
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "middle"
        }
      ]
    }
  ],
  "UUID": "com.gyaltchik.claudedeck"
}
